msgid "Request refused. Reload the page and try again."
msgstr "Požiadavka zamietnutá. Obnov stránku a skús znova."

msgid "You were signed out. Sign in again."
msgstr "Bola si odhlásená. Prihlás sa znova."

msgid "This number or e-mail address is not valid. Check it and try again."
msgstr "Toto číslo alebo e-mail nie je platný. Skontroluj ho a skús znova."

msgid "You asked for many codes. Wait a little, then try again."
msgstr "Vyžiadala si veľa kódov. Chvíľu počkaj a skús znova."

msgid "A code was just sent. Wait a few seconds before asking for a new one."
msgstr "Kód bol práve odoslaný. Pred ďalšou žiadosťou počkaj pár sekúnd."

msgid "We could not send the code. Check the number, then try again in a minute."
msgstr "Kód sa nepodarilo poslať. Skontroluj číslo a skús to o minútu."

msgid "The code does not match. Check the 6 digits you received."
msgstr "Kód nesedí. Skontroluj 6 číslic, ktoré si dostala."

msgid "This code has expired. Ask for a new code."
msgstr "Platnosť kódu vypršala. Vyžiadaj si nový kód."

msgid "Too many wrong codes. Ask for a new code."
msgstr "Príliš veľa nesprávnych kódov. Vyžiadaj si nový kód."

msgid "This code is no longer valid. Ask for a new code."
msgstr "Tento kód už neplatí. Vyžiadaj si nový kód."

msgid "This account is suspended. Write to our team to find out why."
msgstr "Tento účet je pozastavený. Napíš nášmu tímu a zistíš prečo."

msgid "The number, e-mail or password is not correct. You can also sign in with a code."
msgstr "Číslo, e-mail alebo heslo nie je správne. Môžeš sa prihlásiť aj kódom."

msgid "This file is not a photo we can use. Choose a JPEG, PNG or WebP photo."
msgstr "Tento súbor nie je použiteľná fotka. Vyber fotku JPEG, PNG alebo WebP."

