# =============================================================================
# Solange Glow — environment variables
# Copy this file to `.env` (never commit `.env`). Every value below is a
# development default: `docker compose up --build` also works without a .env.
# Business parameters (deadlines, fees, commissions) are NOT here: they are
# edited in the admin (Platform > Platform settings).
# =============================================================================

# --- Django ------------------------------------------------------------------
# Settings module: config.settings.dev (local), config.settings.prod (server).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Secret used to sign sessions and tokens. Use a long random value in production.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
# Show detailed error pages. Must be false in production.
DJANGO_DEBUG=true
# Host names the backend answers to, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Origins allowed to submit forms (admin, web app), comma separated, with scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000
# Log level of the backend: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Database (PostgreSQL + PostGIS) ------------------------------------------
# Name of the database created by the db container.
POSTGRES_DB=solangeglow
# Database user created by the db container.
POSTGRES_USER=solange
# Password of that user. Change it in production.
POSTGRES_PASSWORD=solange
# Connection URL used by Django (docker compose builds it from the values above).
DATABASE_URL=postgis://solange:solange@db:5432/solangeglow
# Seconds a database connection is kept open between requests.
DATABASE_CONN_MAX_AGE=60

# --- Redis (cache, Celery, Channels) -------------------------------------------
# Cache and default Redis URL.
REDIS_URL=redis://redis:6379/0
# Queue used by Celery to send tasks to the worker.
CELERY_BROKER_URL=redis://redis:6379/1
# Where Celery stores task results.
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Redis used by Channels for real time (messaging, notifications).
CHANNELS_REDIS_URL=redis://redis:6379/3
# Maximum duration of a background task, in seconds.
CELERY_TASK_TIME_LIMIT=300
# Seconds platform settings and feature flags stay in cache (they are also
# refreshed immediately when edited in the admin).
PLATFORM_SETTINGS_CACHE_TIMEOUT=300

# --- API ----------------------------------------------------------------------
# Lifetime of an access token, in minutes.
JWT_ACCESS_MINUTES=15
# Lifetime of a refresh token, in days.
JWT_REFRESH_DAYS=30
# Key that signs the tokens (defaults to DJANGO_SECRET_KEY when empty).
JWT_SIGNING_KEY=
# Request limits for visitors and signed-in users.
API_THROTTLE_ANON=120/minute
API_THROTTLE_USER=600/minute

# --- Sign-in cookies ------------------------------------------------------------
# Cookies only sent over HTTPS. false in local development (http), true in production.
AUTH_COOKIE_SECURE=false
# Domain of the cookies (empty = the current site only).
AUTH_COOKIE_DOMAIN=

# --- One-time codes (sign-in by WhatsApp, SMS or e-mail) -----------------------------
# Code lifetime, attempts, limits and channel order are set in the admin
# (Platform > Platform settings, keys starting with "otp.").
# Print codes in the backend logs. Development only: never true in production.
ACCOUNTS_OTP_CONSOLE=true
# Expose /api/v1/dev/last-code for automated browser tests. Development only.
ACCOUNTS_DEV_OTP_ENDPOINT=true

# --- External providers (WhatsApp, SMS, push) ----------------------------------
# Development only: when a provider has no keys, print its messages in the logs
# instead of skipping it (ADR-003). Never true in production.
PROVIDERS_CONSOLE=true
# Seconds to wait for an external provider before giving up (or trying the next channel).
PROVIDERS_HTTP_TIMEOUT=8

# WhatsApp Business Cloud API (Meta). Empty = channel skipped.
# Permanent access token of the system user of the Meta business account.
WHATSAPP_ACCESS_TOKEN=
# ID of the WhatsApp phone number that sends the codes (not the number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved "authentication" template (one per language: fr, en, sk).
WHATSAPP_TEMPLATE_NAME=solange_glow_code
# Graph API version.
WHATSAPP_API_VERSION=v23.0

# SMS fallback through Twilio. Empty = channel skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: Twilio number or alphanumeric sender ID allowed in the destination country.
TWILIO_FROM=

# --- Phone numbers ------------------------------------------------------------
# Country used to read a number typed without +prefix (BJ = Benin).
PHONENUMBER_DEFAULT_REGION=BJ

# --- E-mail (production) ------------------------------------------------------
# SMTP server used to send e-mails. In development e-mails are printed in the logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Sender shown to recipients.
DEFAULT_FROM_EMAIL=Solange Glow <no-reply@solangeglow.com>

# --- Web Push notifications (VAPID) ---------------------------------------------
# Key pair that signs push alerts. Empty in development: a pair is generated once in
# backend/.vapid.json (never committed). In production, generate one with
#   docker compose exec backend python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can write to.
VAPID_SUBJECT=mailto:contact@solangeglow.com
# Address of the web app, used in e-mail links.
SITE_URL=http://localhost:3000

# --- Media storage (S3-compatible, ADR-002) -------------------------------------
# Local development: MinIO (console on http://localhost:9001, same user/password).
MINIO_ROOT_USER=solange
MINIO_ROOT_PASSWORD=solange-minio-dev
# Bucket that holds every uploaded media (public/ and private/ folders).
# Empty = files saved on the disk of the backend (tests only).
AWS_STORAGE_BUCKET_NAME=solangeglow
# Endpoint of the provider: http://minio:9000 locally, the OVH endpoint in production
# (e.g. https://s3.gra.io.cloud.ovh.net).
AWS_S3_ENDPOINT_URL=http://minio:9000
# Region of the bucket.
AWS_S3_REGION_NAME=us-east-1
# Access keys of the storage account (locally: the MinIO user and password).
AWS_ACCESS_KEY_ID=solange
AWS_SECRET_ACCESS_KEY=solange-minio-dev
# Address browsers use to read media. Locally /s3 (the web app relays to MinIO).
# In production: the public address of the bucket or of its CDN. Empty = endpoint.
MEDIA_PUBLIC_BASE_URL=/s3

# --- Production security --------------------------------------------------------
# Redirect every HTTP request to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
# How long browsers must remember to use HTTPS only, in seconds.
DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Web (Next.js) ------------------------------------------------------------
# Backend URL as seen from the web container (server side and API proxy).
API_INTERNAL_URL=http://backend:8000
# MinIO as seen from the web container (relays /s3/* in development).
S3_INTERNAL_URL=http://minio:9000
# Address of the real-time server (notifications). Empty = guessed: same site, or
# port 8000 when the web app runs on port 3000 in development.
NEXT_PUBLIC_WS_ORIGIN=
