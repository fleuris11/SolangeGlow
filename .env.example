# =============================================================================
# Solange Glow — environment variables
# Copy this file to `.env` (never commit `.env`). Every value below is a
# development default: `docker compose up --build` also works without a .env.
# Business parameters (deadlines, fees, commissions) are NOT here: they are
# edited in the admin (Platform > Platform settings).
# =============================================================================

# --- Django ------------------------------------------------------------------
# Settings module: config.settings.dev (local), config.settings.prod (server).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Secret used to sign sessions and tokens. Use a long random value in production.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
# Show detailed error pages. Must be false in production.
DJANGO_DEBUG=true
# Host names the backend answers to, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Origins allowed to submit forms (admin, web app), comma separated, with scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000
# Log level of the backend: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Database (PostgreSQL + PostGIS) ------------------------------------------
# Name of the database created by the db container.
POSTGRES_DB=solangeglow
# Database user created by the db container.
POSTGRES_USER=solange
# Password of that user. Change it in production.
POSTGRES_PASSWORD=solange
# Connection URL used by Django (docker compose builds it from the values above).
DATABASE_URL=postgis://solange:solange@db:5432/solangeglow
# Seconds a database connection is kept open between requests.
DATABASE_CONN_MAX_AGE=60

# --- Redis (cache, Celery, Channels) -------------------------------------------
# Cache and default Redis URL.
REDIS_URL=redis://redis:6379/0
# Queue used by Celery to send tasks to the worker.
CELERY_BROKER_URL=redis://redis:6379/1
# Where Celery stores task results.
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Redis used by Channels for real time (messaging, notifications).
CHANNELS_REDIS_URL=redis://redis:6379/3
# Maximum duration of a background task, in seconds.
CELERY_TASK_TIME_LIMIT=300
# Seconds platform settings and feature flags stay in cache (they are also
# refreshed immediately when edited in the admin).
PLATFORM_SETTINGS_CACHE_TIMEOUT=300

# --- API ----------------------------------------------------------------------
# Lifetime of an access token, in minutes.
JWT_ACCESS_MINUTES=15
# Lifetime of a refresh token, in days.
JWT_REFRESH_DAYS=30
# Key that signs the tokens (defaults to DJANGO_SECRET_KEY when empty).
JWT_SIGNING_KEY=
# Request limits for visitors and signed-in users.
API_THROTTLE_ANON=120/minute
API_THROTTLE_USER=600/minute

# --- Phone numbers ------------------------------------------------------------
# Country used to read a number typed without +prefix (BJ = Benin).
PHONENUMBER_DEFAULT_REGION=BJ

# --- E-mail (production) ------------------------------------------------------
# SMTP server used to send e-mails. In development e-mails are printed in the logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Sender shown to recipients.
DEFAULT_FROM_EMAIL=Solange Glow <no-reply@solangeglow.com>

# --- File storage (production, optional) ---------------------------------------
# When a bucket name is set, uploaded media go to this S3-compatible storage.
AWS_STORAGE_BUCKET_NAME=
# Endpoint of the provider (e.g. https://s3.fr-par.scw.cloud). Empty for AWS.
AWS_S3_ENDPOINT_URL=
# Region of the bucket.
AWS_S3_REGION_NAME=
# Access keys of the storage account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Production security --------------------------------------------------------
# Redirect every HTTP request to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
# How long browsers must remember to use HTTPS only, in seconds.
DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Web (Next.js) ------------------------------------------------------------
# Backend URL as seen from the web container (server side and API proxy).
API_INTERNAL_URL=http://backend:8000
