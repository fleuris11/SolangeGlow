# =============================================================================
# Solange Glow: production settings. Never committed once filled in.
#
#   ./deploy/generate-secrets.sh <domain> <e-mail>
# creates .env.prod from this file and fills the "generated" lines with random values.
# Then fill in the object storage. The rest can wait: an empty provider is simply off,
# and the admin home says what is missing (docs/checklist-mise-en-ligne.md).
#
# Business parameters (fees, deadlines, limits) are NOT here: they are in the admin.
# =============================================================================

# --- Address ------------------------------------------------------------------
# The domain name, without https:// or www. Point these names to the server (DNS):
# the domain itself, www, live, stats, erreurs.
DOMAIN=
# E-mail told to Let's Encrypt for the HTTPS certificates (expiry warnings).
ACME_EMAIL=
# Base of the pros' short links and QR codes. Empty = https://DOMAIN.
SHORT_LINK_BASE_URL=
# Sign-in cookies shared with subdomains. Empty = this exact address only (recommended).
AUTH_COOKIE_DOMAIN=

# --- Secrets generated once (do not change them afterwards) ----------------------
# Signs sessions and tokens. Changed = everyone is signed out.
DJANGO_SECRET_KEY=
# Shared by the web server and Django (the visitor's address for the rate limits).
INTERNAL_API_TOKEN=
# Encrypts the identity documents of the pros (ADR-005). KEEP A COPY OUTSIDE THE SERVER:
# lost = the documents can never be read again.
IDENTITY_VAULT_KEY=
# Encrypts the backups. KEEP A COPY OUTSIDE THE SERVER: lost = backups are useless.
BACKUP_PASSPHRASE=
POSTGRES_PASSWORD=
LIVEKIT_API_SECRET=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# --- Database ------------------------------------------------------------------
POSTGRES_DB=solangeglow
POSTGRES_USER=solange

# --- Object storage (OVH): required ----------------------------------------------
# Bucket of the media (photos, videos, voice notes, encrypted identity documents).
AWS_STORAGE_BUCKET_NAME=
# Address of the storage: https://s3.<region>.io.cloud.ovh.net, e.g. region "gra".
AWS_S3_ENDPOINT_URL=
# The region, e.g. gra.
AWS_S3_REGION_NAME=
# S3 keys of the storage user (OVH: Public Cloud, Users & Roles, S3 credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Form of the addresses: « virtual » (bucket.s3.region...) for OVH, which refuses to serve
# public files at « s3.region.../bucket/... »; empty = « path » (MinIO and most others).
AWS_S3_ADDRESSING_STYLE=
# What makes public pictures readable: OVH has object ACLs, not bucket policies.
MEDIA_PUBLIC_ACL=public-read
# Address browsers use for media. Empty = the address of the storage above. Fill it in with
# a CDN later.
MEDIA_PUBLIC_BASE_URL=

# --- Backups: required -------------------------------------------------------------
# A second bucket, used only for the backups.
BACKUP_BUCKET=
# Hour of the daily backup, UTC (2 = 3 h in Cotonou, 3 or 4 h in Paris).
BACKUP_HOUR_UTC=2
# How many database copies are kept: days, Sundays, first days of the month.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# How long a media file removed from the site stays in the backup, in days.
BACKUP_MEDIA_DELETED_DAYS=30
# Backups with another provider or region (safer). Empty = same place and keys as the media.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION_NAME=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# --- Payments ----------------------------------------------------------------------
# FedaPay (Benin). Webhook to declare: https://DOMAIN/api/v1/payments/webhooks/fedapay
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# sandbox (trials) or live.
FEDAPAY_ENVIRONMENT=sandbox
# Stripe Connect (France, gifts). Webhook to declare: https://DOMAIN/api/v1/payments/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Card on the pro's phone. Empty = not offered. Later: apps.salon.terminal.StripeTerminal
TERMINAL_PROVIDER=
# Approved e-invoicing platform (France). Empty = invoices kept, not transmitted.
EINVOICE_PROVIDER=

# --- Sign-in codes and messages: at least one channel, or nobody can sign in ---------
# WhatsApp Business Cloud API (Meta).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved "authentication" template, one per language (fr, en, sk).
WHATSAPP_TEMPLATE_NAME=solange_glow_code
# SMS through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number or sender name allowed in the destination country.
TWILIO_FROM=
# E-mail through SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Solange Glow <no-reply@solangeglow.com>

# --- Push alerts (generated by deploy/first-run.sh; do not change them afterwards) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@solangeglow.com

# --- Calls and lives -----------------------------------------------------------------
# true once the recording service runs: --profile replay (heavy, 1.5 GB image).
LIVEKIT_EGRESS=false

# --- AI services (optional): empty = off, the team and the word lists do the work ------
MODERATION_AI_URL=
MODERATION_AI_KEY=
QUIZ_AI_URL=
QUIZ_AI_KEY=
HELP_AI_URL=
HELP_AI_KEY=

# --- Audience and errors: filled in after the first start (docs/deploiement.md) ------
# Umami: id of the website created on stats.DOMAIN. Needs ./deploy/update.sh --force-build.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# GlitchTip: DSN of the project created on erreurs.DOMAIN (the same for both).
# The web one needs ./deploy/update.sh --force-build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# false once your own GlitchTip account exists.
GLITCHTIP_REGISTRATION=true
# E-mails of GlitchTip: smtp://user:password@host:587 . Default: none sent.
GLITCHTIP_EMAIL_URL=consolemail://

# --- Server size --------------------------------------------------------------------
# Application processes (about 1 per CPU), background tasks at once (video conversion is
# heavy: 2 is enough on 4 CPUs).
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2
# Database connections kept open by each process (processes x maximum must stay under 100).
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
LOG_LEVEL=INFO
